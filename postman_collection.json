{
  "info": {
    "name": "E-commerce API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1 - Listar Produtos",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:3000/api/products"
        }
      }
    },
    {
      "name": "2 - Cadastrar Produto",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Mouse Gamer\",\n  \"preco\": 150.00\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/products"
        }
      }
    },
    {
      "name": "3 - Buscar por ID",
      "request": {
        "method": "GET",
        "url": {
          "raw": "http://localhost:3000/api/products/6"
        }
      }
    },
    {
      "name": "4 - Atualizar Produto",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nome\": \"Mouse Gamer Pro\",\n  \"preco\": 180.00\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/products/6"
        }
      }
    },
    {
      "name": "5 - Excluir Produto",
      "request": {
        "method": "DELETE",
        "url": {
          "raw": "http://localhost:3000/api/products/6"
        }
      }
    }
  ]
}